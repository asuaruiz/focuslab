NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=https://www.focuslabsmg.com
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Indexal (getindexal.com) webhook. Must be the exact same secret configured in
# the Indexal project, and is used both as the bearer token and as the HMAC key.
INDEXAL_WEBHOOK_SECRET=

# Transactional contact emails (Resend)
RESEND_API_KEY=re_your_api_key
CONTACT_FROM_EMAIL=Focus Labs <notifications@focuslabmg.com>
CONTACT_MANAGER_EMAIL=production@focuslabmg.com
